<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>elgato-decrypter</AssemblyName>
    <RootNamespace>ElgatoDecrypter</RootNamespace>
    <Version>1.0.0</Version>
    <Description>A tool to decrypt Elgato Stream Deck manifest files and plugin packages.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PeterO.Cbor" Version="4.5.2" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>

</Project>
